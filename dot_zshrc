# Managed by chezmoi. Edit ~/.dotfiles/dot_zshrc instead.

export DOTFILES="$HOME/.dotfiles"

if [[ -z "$HOMEBREW_PREFIX" && -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# --- Oh My Zsh

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CACHE_DIR="$HOME/.cache/oh-my-zsh"
ZSH_CUSTOM="$HOME/.config/zsh"  # loads aliases.zsh, path.zsh and plugins/
ZSH_THEME=""
HIST_STAMPS="dd/mm/yyyy"
zstyle ':omz:update' mode reminder

plugins=(
  git brew colored-man-pages colorize cp fzf sudo z
  mise node npm yarn
  docker gcloud kubectl terraform
  zsh-autosuggestions zsh-syntax-highlighting  # must be last
)

[[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
source "$ZSH/oh-my-zsh.sh"

autoload -U promptinit && promptinit
prompt pure

# --- Environment

# English messages, Norwegian formats. Don't set LC_ALL: it breaks number parsing.
export LANG=en_US.UTF-8
export LC_TIME=nb_NO.UTF-8
export LC_MEASUREMENT=nb_NO.UTF-8
export LC_MONETARY=nb_NO.UTF-8

if [[ -n "$SSH_CONNECTION" ]] || ! command -v zed >/dev/null; then
  export EDITOR='vim'
else
  export EDITOR='zed --wait'
fi
export VISUAL="$EDITOR"

# --- Private overrides (gitignored)

for f in "$DOTFILES/.zshrc-private" "$DOTFILES/aliases-private.zsh"; do
  [[ -r "$f" ]] && source "$f"
done
unset f
