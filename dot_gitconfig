# Identity lives in the gitignored gitconfig-private, included at the bottom.

[push]
	autoSetupRemote = true
	default = current
[pull]
	rebase = false
[rebase]
	autoStash = true
	autoSquash = true
[fetch]
	prune = true
	pruneTags = true
[init]
	defaultBranch = main
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[diff]
	algorithm = histogram
	colorMoved = zebra
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoUpdate = true
[help]
	autocorrect = prompt
[log]
	follow = true
[core]
	precomposeUnicode = true
	fsmonitor = true
	untrackedCache = true
[credential]
	helper = osxkeychain
[commit]
	gpgsign = true
[gpg]
	format = ssh
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[alias]
	pushf = push --force-with-lease
[include]
	path = ~/.dotfiles/gitconfig-private
