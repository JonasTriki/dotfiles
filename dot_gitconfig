# Managed by chezmoi. Identity is deliberately absent: it lives in the
# gitignored gitconfig-private, included at the bottom, so no email address is
# committed to this public repo.

[push]
	autoSetupRemote = true
	default = current

[pull]
	rebase = false

[rebase]
	autoStash = true
	autoSquash = true

[fetch]
	prune = true
	pruneTags = true

[init]
	defaultBranch = main

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[diff]
	# Better rename/content detection than the default Myers algorithm.
	algorithm = histogram
	colorMoved = zebra

[merge]
	# Include the common ancestor in conflict markers.
	conflictStyle = zdiff3

[rerere]
	# Remember how conflicts were resolved and reuse it.
	enabled = true
	autoUpdate = true

[help]
	# Suggest a correction for a typo'd subcommand instead of running it.
	autocorrect = prompt

[log]
	follow = true

[core]
	precomposeUnicode = true
	fsmonitor = true
	untrackedCache = true

[credential]
	helper = osxkeychain

# Sign commits with the SSH key generated by scripts/ssh.sh.
[commit]
	gpgsign = true

[gpg]
	format = ssh

[user]
	signingkey = ~/.ssh/id_ed25519.pub

[alias]
	pushf = push --force-with-lease

# Git ignores missing include paths, so this is safe without a private file.
[include]
	path = ~/.dotfiles/gitconfig-private
