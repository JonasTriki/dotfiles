#!/usr/bin/env bash
# Re-runs whenever a Brewfile changes: chezmoi re-runs this script when its
# rendered content changes, and these hashes are part of it.
# Brewfile: {{ include "Brewfile" | sha256sum }}
# Brewfile.private: {{ if stat (joinPath .chezmoi.sourceDir "Brewfile.private") }}{{ include "Brewfile.private" | sha256sum }}{{ end }}

command -v brew >/dev/null || exit 0
exec {{ printf "%s/scripts/brew.sh" .chezmoi.sourceDir | quote }}
